# ==============================================================================
# BRANDTRACE — Production Environment Variables Reference
# ==============================================================================
# Set these values in your hosting dashboards (Render, Vercel, Neon).
# DO NOT commit real passwords or production API keys to Git.

# ------------------------------------------------------------------------------
# 1. RENDER WEB SERVICE (FastAPI Backend)
# ------------------------------------------------------------------------------
# Neon Serverless PostgreSQL connection URI (auto-normalized to postgresql+psycopg://):
DATABASE_URL=postgresql://brandtrace_owner:npg_SecretPass@ep-cool-fog-123456.us-east-2.aws.neon.tech/brandtrace?sslmode=require

# Explicit comma-separated CORS origins (add your Vercel URL once deployed):
CORS_ORIGINS=https://brandtrace-woad.vercel.app,http://localhost:3000

# Security and Authentication
ENVIRONMENT=staging
AUTH_MODE=token
ALLOW_DEMO_AUTH=false
ALLOW_DEMO_RESET=false
BRANDTRACE_ADMIN_API_KEY=your-production-admin-api-key-here
BRANDTRACE_API_KEY=your-production-reviewer-api-key-here

# Backend Python runtime version
PYTHON_VERSION=3.10.11

# Content analysis constraints
MAX_CONTENT_CHARS=50000
MAX_UPLOAD_BYTES=10485760

# Database connection pool tuning for serverless (optional, defaults are shown)
DB_POOL_RECYCLE=300
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Optional Server-Side AI Provider (mock runs 100% free & offline, or use gemini)
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
AI_TIMEOUT_SECONDS=8.0

# Optional Server-Side Groq Vision OCR & Content Intelligence (FastAPI backend only)
# Never expose GROQ_API_KEY to Vercel frontend or git.
GROQ_ENABLED=false
GROQ_API_KEY=your-production-groq-api-key-here
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# 2. VERCEL (React + Vite Frontend)
# ------------------------------------------------------------------------------
# Build-time public environment variable.
# Point to your Render backend web service URL (trailing slashes or /api are safely handled).
VITE_API_BASE_URL=https://brandtrace-api.onrender.com
VITE_APP_ENV=staging
