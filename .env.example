# ==============================================================================
# BRANDTRACE — Environment Configuration Template
# Copy this file to .env for local development. Never commit real secret keys.
# ==============================================================================

# Frontend Configuration
# Leave blank for local Vite development proxy (redirects /api to 127.0.0.1:8000),
# or set to deployed backend origin URL if running independently.
VITE_API_BASE_URL=
VITE_API_PROXY=http://127.0.0.1:8000

# Explicit Environment Classification (Required for honest runtime presentation)
# Supported values: local, demo, staging, production
# - local: Local Development environment
# - demo: Local Demo environment (recommended for local demonstration)
# - staging: Hosted Staging deployment (e.g. Neon PostgreSQL staging)
# - production: Production deployment
VITE_APP_ENV=demo

# Backend Configuration
# SQLite local file path (default zero-setup local demo).
# For PostgreSQL deployment, use: postgresql+psycopg://username:password@hostname:5432/brandtrace
DATABASE_URL=sqlite:///./brandtrace.db

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Governance Constraints
MAX_CONTENT_CHARS=50000
MAX_UPLOAD_BYTES=10485760

# Optional Server-Side AI Provider Configuration
# The default 'mock' provider runs 100% offline using deterministic heuristics and BM25 topic grounding.
# To enable real server-side Gemini analysis, set AI_PROVIDER=gemini and provide AI_PROVIDER_API_KEY.
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
AI_TIMEOUT_SECONDS=8.0

# Authentication & Demo Reset Controls
AUTH_MODE=demo
ALLOW_DEMO_AUTH=true
ALLOW_DEMO_RESET=false
DEMO_RESET_SECRET=
BRANDTRACE_API_KEY=
BRANDTRACE_ADMIN_API_KEY=

# Optional Groq Vision OCR & Content Intelligence (Server-Side Only)
# Never expose GROQ_API_KEY to frontend code or commit live keys to git.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15.0
GROQ_MAX_PDF_PAGES=10
GROQ_MAX_IMAGES_PER_REQUEST=3

